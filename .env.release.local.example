# Copy to .env.release.local (gitignored) and fill in for Udi's personal
# Apple account. These feed the scripts/ios-*.sh release toolchain.

# App Store Connect app id for Intervals — created once via `asc` (see plan).
ASC_APP_ID=

# App Store Connect API key (personal account).
# Find both in App Store Connect -> Users and Access -> Integrations ->
# App Store Connect API. ASC_KEY_ID is the 10-char "Key ID" column (e.g.
# ABC123XYZ9) -- NOT a file path. ASC_ISSUER_ID is the UUID at the top.
ASC_KEY_ID=
ASC_ISSUER_ID=

# Path to the downloaded .p8 key file (the file, not the Key ID).
ASC_PRIVATE_KEY_PATH=/Users/udi/.ssh/intervals_asc_key.p8

# Apple Developer team (same account SwearBuy ships under). Already the default
# in release-env.sh, shown here for clarity.
IOS_DEVELOPMENT_TEAM=K5FGQ428RU

# Optional TestFlight "What to Test" notes.
# ASC_TEST_NOTES_PRODUCTION=First TestFlight build of Intervals.
# ASC_TEST_NOTES_LOCALE=en-US
